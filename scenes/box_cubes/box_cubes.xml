<scene version="0.5.0">
    <integrator type="path"/>
    <sampler type="independent">
        <integer name="sampleCount" value="128"/>
    </sampler>

    <camera type="perspective">
        <float name="fov" value="60.0"/>
        <integer name="width" value="512"/>
        <integer name="height" value="512"/>
        <transform name="toWorld">
            <lookat origin="0.0, 1.1, 2.2" target="0.0, 0.35, -0.4" up="0.0, 1.0, 0.0"/>
        </transform>
    </camera>

    <!-- Metallic Floor -->
    <mesh id="floor" type="ply">
        <string name="filename" value="floor.ply"/>
        <bsdf type="metallic">
            <color name="albedo" value="0.85 0.85 0.9"/>
            <float name="roughness" value="0.18"/>
        </bsdf>
    </mesh>

    <!-- Metallic Back Wall -->
    <mesh id="wall" type="ply">
        <string name="filename" value="wall.ply"/>
        <bsdf type="metallic">
            <color name="albedo" value="0.85 0.85 0.9"/>
            <float name="roughness" value="0.25"/>
        </bsdf>
    </mesh>

    <!-- Red Diffuse Cube -->
    <mesh id="red_cube" type="ply">
        <string name="filename" value="red_cube.ply"/>
        <bsdf type="diffuse">
            <color name="albedo" value="0.9 0.2 0.15"/>
        </bsdf>
    </mesh>

    <!-- Blue Diffuse Cuboid -->
    <mesh id="blue_cuboid" type="ply">
        <string name="filename" value="blue_cuboid.ply"/>
        <bsdf type="diffuse">
            <color name="albedo" value="0.15 0.4 0.9"/>
        </bsdf>
    </mesh>

    <!-- Ceiling Area Light -->
    <mesh id="light" type="ply">
        <string name="filename" value="light.ply"/>
        <bsdf type="diffuse">
            <color name="albedo" value="0.8 0.8 0.8"/>
        </bsdf>
        <emitter type="area">
            <color name="radiance" value="6.0 6.0 6.0"/>
        </emitter>
    </mesh>
</scene>
