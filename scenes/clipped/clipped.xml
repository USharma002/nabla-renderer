<scene version="0.5.0">
    <integrator type="path"/>
    <sampler type="independent"><integer name="sampleCount" value="128"/></sampler>

    <camera type="perspective">
        <float name="fov" value="60.0"/>
        <integer name="width" value="512"/>
        <integer name="height" value="512"/>
        <transform name="toWorld">
            <lookat origin="0.0, 0.0, 3.0" target="0.0, 0.0, 0.0" up="0.0, 1.0, 0.0"/>
        </transform>
    </camera>

    <!-- Front Area Light -->
    <mesh type="ply">
        <string name="filename" value="light.ply"/>
        <bsdf type="diffuse"><color name="albedo" value="0.8 0.8 0.8"/></bsdf>
        <emitter type="area"><color name="radiance" value="4.0 4.0 4.0"/></emitter>
    </mesh>

    <!-- Clipped Triangle -->
    <mesh type="ply">
        <string name="filename" value="clipped_tri.ply"/>
        <bsdf type="diffuse"><color name="albedo" value="0.35 0.65 0.95"/></bsdf>
    </mesh>
</scene>
