<scene version="0.5.0">
    <integrator type="path"/>
    <sampler type="independent">
        <integer name="sampleCount" value="64"/>
    </sampler>

    <camera type="perspective">
        <float name="fov" value="45.0"/>
        <integer name="width" value="512"/>
        <integer name="height" value="512"/>
        <transform name="toWorld">
            <lookat origin="0.0, 0.0, 3.0" target="0.0, 0.0, 0.0" up="0.0, 1.0, 0.0"/>
        </transform>
    </camera>

    <!-- Top Illumination Light -->
    <mesh type="ply">
        <string name="filename" value="light.ply"/>
        <bsdf type="diffuse">
            <color name="albedo" value="0.8 0.8 0.8"/>
        </bsdf>
        <emitter type="area">
            <color name="radiance" value="3.5 3.5 3.5"/>
        </emitter>
    </mesh>

    <!-- Front Green Triangle -->
    <mesh type="ply">
        <string name="filename" value="green_tri.ply"/>
        <bsdf type="diffuse">
            <color name="albedo" value="0.4 0.65 0.4"/>
        </bsdf>
    </mesh>
</scene>
