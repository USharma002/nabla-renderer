<scene version="0.5.0">
    <integrator type="path"/>
    <sampler type="independent">
        <integer name="sampleCount" value="128"/>
    </sampler>

    <camera type="perspective">
        <float name="fov" value="35.0"/>
        <integer name="width" value="512"/>
        <integer name="height" value="512"/>
        <transform name="toWorld">
            <lookat origin="0.0, 1.3, 4.8" target="0.0, 0.05, 0.0" up="0.0, 1.0, 0.0"/>
        </transform>
    </camera>

    <!-- Shiny Reflective Floor -->
    <mesh id="floor" type="ply">
        <string name="filename" value="floor.ply"/>
        <bsdf type="metallic">
            <color name="albedo" value="0.85 0.85 0.9"/>
            <float name="roughness" value="0.95"/>
        </bsdf>
    </mesh>

    <!-- Overhead Light (Out of Camera View) -->
    <mesh id="light" type="ply">
        <string name="filename" value="light.ply"/>
        <bsdf type="diffuse">
            <color name="albedo" value="0.8 0.8 0.8"/>
        </bsdf>
        <emitter type="area">
            <color name="radiance" value="15.0 15.0 15.0"/>
        </emitter>
    </mesh>

    <!-- Metallic Chrome Teapot Sitting On Floor -->
    <mesh id="teapot" type="ply">
        <string name="filename" value="teapot.ply"/>
        <transform name="toWorld">
            <scale value="0.22, 0.22, 0.22"/>
            <rotate x="1" angle="-90"/>
            <translate value="0.0, 0.0, 2.0"/>
        </transform>
        <bsdf type="metallic">
            <color name="albedo" value="0.95 0.95 0.98"/>
            <float name="roughness" value="0.13"/>
        </bsdf>
    </mesh>

    <!-- Colorful Donut (Torus) Behind Camera Reflecting in Teapot -->
    <mesh id="donut" type="ply">
        <string name="filename" value="donut.ply"/>
        <transform name="toWorld">
            <scale value="1.8, 1.8, 1.8"/>
            <translate value="0.0, 1.5, 6.5"/>
        </transform>
        <bsdf type="diffuse">
            <color name="albedo" value="1.0 0.25 0.55"/>
        </bsdf>
    </mesh>
</scene>
