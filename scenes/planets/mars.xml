<scene version="0.5.0">
    <integrator type="path"/>
    <sampler type="independent">
        <integer name="sampleCount" value="256"/>
    </sampler>

    <camera type="perspective">
        <float name="fov" value="60.0"/>
        <integer name="width" value="512"/>
        <integer name="height" value="512"/>
        <transform name="toWorld">
            <!-- Camera looking from above, closer to the planet -->
            <lookat origin="0.0, 4.0, 3.5" target="0.0, 0.75, 0.0" up="0.0, 1.0, 0.0"/>
        </transform>
    </camera>

    <!-- Metallic Floor (Scaled up 4x, Low roughness for sharp reflection) -->
    <mesh id="floor" type="ply">
        <string name="filename" value="../box_cubes/floor.ply"/>
        <transform name="toWorld">
            <scale value="4.0, 1.0, 4.0"/>
        </transform>
        <bsdf type="metallic">
            <color name="albedo" value="0.85 0.85 0.9"/>
            <float name="roughness" value="0.10"/>
        </bsdf>
    </mesh>

    <!-- Planet Sphere (Scaled up 1.25x) -->
    <mesh id="planet" type="obj">
        <string name="filename" value="sphere.obj"/>
        <transform name="toWorld">
            <scale value="1.25, 1.25, 1.25"/>
            <translate value="0.0, 0.75, 0.0"/>
        </transform>
        <bsdf type="diffuse">
            <texture name="texture">
                <string name="filename" value="mars.jpg"/>
            </texture>
        </bsdf>
    </mesh>

    <!-- ============================================== -->
    <!-- Wider circle (Radius 2.4) of 5 Perfect Mirrors -->
    <!-- ============================================== -->

    <!-- Mirror 1 (Far Left) -->
    <mesh id="mirror_1" type="ply">
        <string name="filename" value="perfect_mirror.ply"/>
        <transform name="toWorld">
            <rotate x="1" y="0" z="0" angle="-15"/>
            <rotate x="0" y="1" z="0" angle="90"/>
            <translate value="-2.4, 0.8, 0.0"/>
        </transform>
        <bsdf type="metallic">
            <color name="albedo" value="0.95 0.95 0.95"/>
            <float name="roughness" value="0.03"/>
        </bsdf>
    </mesh>

    <!-- Mirror 2 (Back-Left) -->
    <mesh id="mirror_2" type="ply">
        <string name="filename" value="perfect_mirror.ply"/>
        <transform name="toWorld">
            <rotate x="1" y="0" z="0" angle="-15"/>
            <rotate x="0" y="1" z="0" angle="45"/>
            <translate value="-1.7, 0.8, -1.7"/>
        </transform>
        <bsdf type="metallic">
            <color name="albedo" value="0.95 0.95 0.95"/>
            <float name="roughness" value="0.03"/>
        </bsdf>
    </mesh>

    <!-- Mirror 3 (Directly Behind) -->
    <mesh id="mirror_3" type="ply">
        <string name="filename" value="perfect_mirror.ply"/>
        <transform name="toWorld">
            <rotate x="1" y="0" z="0" angle="-15"/>
            <rotate x="0" y="1" z="0" angle="0"/>
            <translate value="0.0, 0.8, -2.4"/>
        </transform>
        <bsdf type="metallic">
            <color name="albedo" value="0.95 0.95 0.95"/>
            <float name="roughness" value="0.03"/>
        </bsdf>
    </mesh>

    <!-- Mirror 4 (Back-Right) -->
    <mesh id="mirror_4" type="ply">
        <string name="filename" value="perfect_mirror.ply"/>
        <transform name="toWorld">
            <rotate x="1" y="0" z="0" angle="-15"/>
            <rotate x="0" y="1" z="0" angle="-45"/>
            <translate value="1.7, 0.8, -1.7"/>
        </transform>
        <bsdf type="metallic">
            <color name="albedo" value="0.95 0.95 0.95"/>
            <float name="roughness" value="0.03"/>
        </bsdf>
    </mesh>

    <!-- Mirror 5 (Far Right) -->
    <mesh id="mirror_5" type="ply">
        <string name="filename" value="perfect_mirror.ply"/>
        <transform name="toWorld">
            <rotate x="1" y="0" z="0" angle="-15"/>
            <rotate x="0" y="1" z="0" angle="-90"/>
            <translate value="2.4, 0.8, 0.0"/>
        </transform>
        <bsdf type="metallic">
            <color name="albedo" value="0.95 0.95 0.95"/>
            <float name="roughness" value="0.03"/>
        </bsdf>
    </mesh>

    <!-- Ceiling Area Light -->
    <mesh id="light" type="ply">
        <string name="filename" value="../box_cubes/light.ply"/>
        <transform name="toWorld">
            <!-- Scaled the light to be 2x bigger in X and Z, and moved up to 4.0 -->
            <scale value="2.0, 1.0, 2.0"/>
            <translate value="0.0, 4.0, 0.0"/>
        </transform>
        <bsdf type="diffuse">
            <color name="albedo" value="0.8 0.8 0.8"/>
        </bsdf>
        <emitter type="area">
            <color name="radiance" value="6.0 6.0 6.0"/>
        </emitter>
    </mesh>
</scene>